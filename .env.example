# ===== PostgreSQL =====
LLMPOD_PG_HOST=localhost
LLMPOD_PG_PORT=35432
LLMPOD_PG_USER=postgres
LLMPOD_PG_PASSWORD=change-me-pg-password  # 部署前换成本环境的随机值（与 docker/.env.deps 同步）
LLMPOD_PG_DATABASE=llmpod
LLMPOD_PG_POOL_SIZE=10
LLMPOD_PG_MAX_OVERFLOW=20

# ===== Redis =====
LLMPOD_REDIS_HOST=localhost
LLMPOD_REDIS_PORT=26739
LLMPOD_REDIS_PASSWORD=change-me-redis-password
LLMPOD_REDIS_DB=0
LLMPOD_REDIS_MAX_CONNECTIONS=50

# ===== 安全 =====
LLMPOD_TOKEN_EXPIRE_SECONDS=86400
LLMPOD_TOKEN_KEY_PREFIX=llmpod:token:
# 应用层加密密钥（API key 明文回显 + Model.source_auth 密文共用）。
# 生产务必显式设置随机值；留空则回退仓库内置 dev 默认 key——任何能读源码的人
# 都能解密所有 API key 明文（可逆加密的边界就在这把钥匙）。
LLMPOD_SECRET_KEY=

# ===== 管理端（webserver + manager）=====
LLMPOD_WEBSERVER_HOST=0.0.0.0
LLMPOD_WEBSERVER_PORT=8080
LLMPOD_MANAGER_WS_PATH=/ws/node

# ===== API 网关（proxyserver）=====
LLMPOD_PROXY_HOST=0.0.0.0
LLMPOD_PROXY_PORT=8090

# ===== 指标（proxyserver /metrics + 中央 scraper）=====
# /metrics bearer token（fail-closed：空 = 端点一律 401，scraper 每 15s 抓取 401
# 只刷 warning、指标管线全空）。API 网关（proxyserver）与管理端共用此值，两处必须一致。
LLMPOD_METRICS_TOKEN=
# scraper 额外静态抓取目标（逗号分隔 URL；默认已含 proxyserver 8090。引擎指标
# 由 scraper 按 DB 自动发现直抓，无需配置）
LLMPOD_METRICS_SCRAPE_TARGETS=http://127.0.0.1:8090/metrics
# 抓取间隔分档（秒）：API 网关管道指标固定档（喂 5min 桶 + 实时热层，密度
# 需稳定）；引擎快档=实时面板被消费时、慢档=无人看时的心跳（自动升降）。
# 旧键 LLMPOD_METRICS_SCRAPE_INTERVAL 已废弃（仅回退引擎两档，勿再使用）
LLMPOD_METRICS_SCRAPE_INTERVAL_PROXY=5
LLMPOD_METRICS_SCRAPE_INTERVAL_ENGINE_FAST=5
LLMPOD_METRICS_SCRAPE_INTERVAL_ENGINE_SLOW=30
# 指标保留期（天）
LLMPOD_METRICS_RETENTION_DAYS=90

# ===== 节点 =====
LLMPOD_NODE_ID=
# 默认集群的 id（不再写死=1）：以 init_db 打印的 id / GET /clusters 为准。
# 新库自增通常为 1，但删后重建会变；节点引导脚本会注入实际值（见 bootstrap-token）。
LLMPOD_NODE_CLUSTER_ID=1
LLMPOD_NODE_TOKEN=
LLMPOD_NODE_TOKEN_FILE=data/node_token
LLMPOD_NODE_ID_FILE=data/node_id
# 本机对外的管理端地址（管理端读取）：只填 IP 或域名，节点回连的 WS 地址与
# 文件服务 / 引导命令的 http origin 都由它拼出。留空 = localhost，本机开发够用；
# 多机部署务必填外部可达地址（非 0.0.0.0 / 非 localhost），否则引导脚本渲染出的
# MANAGER_URL 节点连不回来。
#   例：LLMPOD_NODE_MANAGER_IP=192.168.1.20               # 内网直连，`hostname -I` 查本机 IP
#   例：LLMPOD_NODE_MANAGER_IP=llmpod.example.com         # 公网 / 固定域名
#   例：LLMPOD_NODE_MANAGER_IP=wss://llmpod.example.com   # 反向代理 + HTTPS（TLS 终结在反向代理）
LLMPOD_NODE_MANAGER_IP=
# 节点读取：要连的管理端完整 WS 地址（本机开发由 make node-up 从本文件透传，
# 正式部署由引导脚本注入同值）。
LLMPOD_NODE_MANAGER_URL=ws://localhost:8080/ws/node
LLMPOD_NODE_HEARTBEAT_INTERVAL=10
LLMPOD_NODE_RECONNECT_FAST_INTERVAL=5
LLMPOD_NODE_RECONNECT_SLOW_INTERVAL=30
LLMPOD_NODE_RECONNECT_FAST_WINDOW=60
LLMPOD_NODE_HEARTBEAT_TIMEOUT=60

# ===== 节点引导令牌（管理员签发的短期令牌）=====
# 无登录态启动节点。默认 8h、上限 24h；签发时 ttl 可在 [60, max] 内自定义。
LLMPOD_BOOTSTRAP_TOKEN_TTL=28800
LLMPOD_BOOTSTRAP_TOKEN_MAX_TTL=86400

# ===== GPU 状态缓冲 =====
LLMPOD_GPU_FLUSH_INTERVAL=10
LLMPOD_GPU_VRAM_CHANGE_THRESHOLD=1.0
LLMPOD_GPU_UTIL_CHANGE_THRESHOLD=0.1
LLMPOD_GPU_STALE_TIMEOUT=120

# ===== 模型分发（local 源由管理端文件服务下发）=====
LLMPOD_DOWNLOAD_MIN_FREE_GB=10.0
# 文件服务地址不用配：节点在线时按其连接 Host 自动回推（内网节点拿内网、外网节点拿外网），
# 只有目标节点还没连上时才回退到上面那个 LLMPOD_NODE_MANAGER_IP。
# local 源下载令牌（短期 HMAC，节点访问文件服务用）：默认 30 分钟，上限 2 小时
LLMPOD_DOWNLOAD_TOKEN_TTL=1800
LLMPOD_DOWNLOAD_TOKEN_MAX_TTL=7200
LLMPOD_DOWNLOAD_CHUNK_SIZE=1048576
LLMPOD_DOWNLOAD_MANIFEST_CACHE_TTL=60

# ===== 模型源探测（inspect：抓 config.json / 文件清单，不下载）=====
# 国内 huggingface.co 默认不可达 → 改 https://hf-mirror.com 加速（inspect + 节点下载共用 fallback）
LLMPOD_MODEL_SOURCE_HF_ENDPOINT=https://huggingface.co
LLMPOD_MODEL_SOURCE_PROBE_TIMEOUT=10

# ===== CORS =====
# 两平面（管理端 / API 网关）共用，默认 ["*"] 放行：租户端在线调试由浏览器直连
# 网关端口（与管理端不同端口即跨源），收紧默认会打断功能；无 Cookie 会话，通配符
# 实际风险有限。要收紧时配来源白名单，如 ["https://admin.example.com"]
LLMPOD_CORS_ORIGINS=["*"]

# ===== 日志 =====
LLMPOD_LOG_LEVEL=info

# ===== API 文档 =====
# Swagger UI / OpenAPI 文档（开发环境建议开启，生产环境建议关闭）
LLMPOD_DOCS_ENABLED=true

# ===== 管理员引导凭据（前缀必须为 LLMPOD_，否则被 extra=ignore 静默丢弃）=====
# 仅首次建库生效：留空=随机生成并写 data/admin_credentials；之后改这里无效，改密走管理后台。
# 开发环境固定 admin/admin 便于反复 db-reset 后直接登录。
LLMPOD_ADMIN_USER=admin
LLMPOD_ADMIN_PASSWORD=admin


