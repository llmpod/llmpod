{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@repo/hooks": ["../../packages/hooks/src/index.ts"],
      "@repo/hooks/*": ["../../packages/hooks/src/*"],
      "@repo/naive-ui": ["../../packages/naive-ui/src/index.ts"],
      "@repo/naive-ui/*": ["../../packages/naive-ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/env.d.ts"]
}
