# LLMPod 本地开发依赖栈配置. 拷贝为 .env.deps 后按需修改 (make deps-up 首次自动拷贝).
# 注意: docker compose 的 .env 解析对「空值行尾注释」会误把注释当值, 故本文件
#       一律用整行注释, 值后不留行内注释.
# !!! POSTGRES_*/REDIS_* 必须与根 .env 的 LLMPOD_PG_*/LLMPOD_REDIS_* 一致
#     —— scripts/init_db.py 以 POSTGRES_USER 连 postgres 库建库建用户;
#        app 用 LLMPOD_PG_PORT 连 127.0.0.1. 不一致则连不上.

# ---- 镜像 tag (与其它栈保持一致) ----
POSTGRES_TAG=16.3
REDIS_TAG=7.4.0

# ---- PostgreSQL (容器超级用户 == app 的 LLMPOD_PG_USER) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-pg-password
POSTGRES_DB=llmpod
# 宿主机发布端口 == 根 .env 的 LLMPOD_PG_PORT
POSTGRES_PORT=35432

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password
# == 根 .env 的 LLMPOD_REDIS_PORT
REDIS_PORT=26739
