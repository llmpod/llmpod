# ---- 数据库 Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-pg-password
POSTGRES_DB=llmpod
POSTGRES_PORT=15432

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=16739

# ---- 管理端 (webserver + manager) ----
WEBSERVER_PORT=18080
# 管理员引导凭据（可选，仅首次建库生效）：
#   留空（默认）→ 随机生成用户名+密码，写入容器 /app/data/admin_credentials，
#                查看命令：docker compose -f docker/docker-compose.yml --env-file docker/.env exec -T webserver cat /app/data/admin_credentials
#   取消注释并填值 → 用填写的用户名/密码创建（生产建议直接后台改强密码）。
# 建库之后再改这两项不会生效：不会种新号、也不会覆盖密码，改密/改名走管理后台。
#LLMPOD_ADMIN_USER=admin
#LLMPOD_ADMIN_PASSWORD=admin
LLMPOD_DOCS_ENABLED=false  # Swagger/OpenAPI（管理端+API 网关）；调试时改 true，生产保持关

# API Key 明文 / 模型源凭据的可逆加密密钥：留空（默认）= 首启随机生成落 /app/data/secret_key
# （随 webserver-data 卷持久化）。多实例/需统一托管时显式配置同一值。
#LLMPOD_SECRET_KEY=

# 节点连接 Manager 的地址：裸 IP/域名使用 ws://，也可填完整的 wss:// 反代地址。
#   例：LLMPOD_NODE_MANAGER_IP=192.168.1.20
#   例：LLMPOD_NODE_MANAGER_IP=wss://llmpod.example.com
# 留空 = localhost，只在节点与 manager 同机时可用——否则 bootstrap 会把节点引向它自己，连不上。
# install.sh 装机时按探测到的本机 IP 自动填好，自部署再按上面三选一。
LLMPOD_NODE_MANAGER_IP=
# 内网直连候选（逗号分隔的本机内网 IP）：bootstrap 引导脚本把它渲染成回连候选，
# 节点机逐个探活（GET /health），内网通走直连、全不通落上面的对外地址兜底。
# install.sh 装机时按本机网卡自动填好；多网卡/多网段手工增删即可。
LLMPOD_NODE_MANAGER_IP_LAN=

# 节点自动升级（默认关）。开 = manager 升级重启后节点重连对账自动跟随升级；
# 关 = 落后节点只标 outdated 不下发升级提议，改走 admin 节点页手动触发（不受此开关限制）。
LLMPOD_NODE_AUTO_UPGRADE=false

# ---- API 网关 (proxyserver) ----
# 遥测开关
LLMPOD_TELEMETRY_ENABLED=true
# 端口约定：*_PORT 是唯一定义处——既是宿主机对外端口也是容器内监听端口
# （compose 映射写 "${PROXY_PORT}:${PROXY_PORT}" 并回注容器 env），改一处全链路生效。
# 该值同时是 /api/v1/proxy-endpoint 未配宣告地址时拼端口的依据。
PROXY_PORT=18090
# API 网关对外宣告地址（external_url 风格完整地址）：仅在固定 IP/域名接入、或将来用 Nginx
# 把 webserver 和 proxyserver 统一成域名（如 admin.xxx.com / api.xxx.com）时才需要配；
# 空 = 按请求 Host + PROXY_PORT 推导（局域网 IP / 公网 IP / localhost 访问各自正确）。
LLMPOD_PROXY_ADVERTISE_URL=

# 模型仓库宿主侧路径：webserver 容器挂载做 local 源内容指纹/文件服务下发根。
# 容器内恒 /data/models（集群级不变量，不作配置）；manager 机大盘在别处时只改本值。
MODEL_HOST_DIR=/data/models

# ---- 通用 ----
# 主机绑定 IP (manager 侧端口暴露地址)
HOST_IP=0.0.0.0
